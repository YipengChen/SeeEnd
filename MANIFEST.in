include README.en.md LIBRARY_REPLACEMENT.md
include app.py package.json package-lock.json CONTRIBUTING.md
recursive-include packaging *.py *.spec *.json
prune packaging/generated_licenses
prune third_party_sources
recursive-include tests *.py *.js
# Documentation lives in the repository and is included directly.
recursive-include docs *.md *.png *.jpg *.gif *.svg *.html *.json *.txt *.zip
prune docs/reference-full-analysis
global-exclude __pycache__ *.py[cod] .DS_Store
