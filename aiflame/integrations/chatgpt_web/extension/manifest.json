{
  "manifest_version": 3,
  "name": "SeeEnd · AI 网页完成提醒",
  "version": "0.2.8",
  "description": "将 ChatGPT、Gemini、Claude 等 AI 网页的生成与完成状态接入本机 SeeEnd。需配合桌面应用使用，不读取提问或回答正文。",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.deepseek.com/*",
        "https://www.qianwen.com/*",
        "https://qianwen.com/*",
        "https://tongyi.aliyun.com/qianwen*",
        "https://www.doubao.com/chat*",
        "https://yuanbao.tencent.com/*",
        "https://www.kimi.com/*",
        "https://kimi.com/*",
        "https://kimi.moonshot.cn/*",
        "https://chatglm.cn/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*"
      ],
      "js": [
        "detector.js",
        "providers.js",
        "state.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "https://www.qianwen.com/*",
        "https://qianwen.com/*",
        "https://tongyi.aliyun.com/qianwen*",
        "https://chatglm.cn/*"
      ],
      "js": [
        "frames.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    }
  ],
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  }
}
